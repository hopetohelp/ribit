{
  "name": "ribit",
  "version": "0.2.3",
  "description": "Offline Ribit compound interest calculator",
  "author": "Ribit",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.hopetohelp.ribit",
    "productName": "Ribit",
    "artifactName": "Ribit-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "updates.cjs"
    ],
    "extraResources": [
      {
        "from": "../web/app",
        "to": "app"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://ribit.hopetohelp.net/updates/windows/"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "js-yaml": "4.3.2"
  }
}
